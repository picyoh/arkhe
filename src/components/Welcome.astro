---
import { Image } from "astro:assets";
import heroImage from "../assets/Fichier_30.svg";
import { Icon } from "astro-icon/components";
---

<style>
    .heroContainer {
        color: #fafae6;
        background-color: #141303;
        height: 100%;
        display: flex;
        flex-flow: column;
        justify-content: center;
        align-items: center;
        gap: 4rem;
    }

    .caps {
        text-transform: uppercase;
    }

    .scroller {
        border: 2px solid #ff2400;
        border-radius: 1rem;
        width: 1.5rem;
        height: 3rem;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    [data-icon] {
        color: #ff2400;
        font-size: 64px;
    }

</style>
<div class="heroContainer">
    <Image class="heroImage" src={heroImage} alt="Logo Arkhé" width="450" />
    <p class="caps">Arkhé, le studio qui vous veut du bien</p>
    <span class="scroller">
        <Icon name="fa7-solid:long-arrow-down" />
    </span>
</div>
