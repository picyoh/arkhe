---
const { title, href, id } = Astro.props;
---

<style>
    .buttons {
        padding: .5rem .2rem;
        color: #007fff;
        background-color: #e8c4ff;
        border: 1px solid #007fff;
        border-radius: .3rem;
        font-size: .7rem;
        font-family: var(--font-geist);
        text-transform: uppercase;
        text-decoration: none;
    }
    #contact {
        position: relative;
        left: 10%;
    }
</style>

<>
    <a id={id} class="buttons" href={href}>{title}</a>
</>

<script>
    const buttonsElements = document.querySelectorAll("buttons");
    buttonsElements.forEach((button) => {
        button.addEventListener("click", (e) => {
            console.log(e.target);
        });
    });
</script>
